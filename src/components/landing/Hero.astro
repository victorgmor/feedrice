---
import Text from "@/components/fundations/elements/Text.astro";

interface Props {
  title?: string;
  class?: string;
}

const { title = "See the best posts first.", class: className = "" } = Astro.props;
---

<div>
  <Text
    tag="h1"
    variant="display3XL"
    class={`text-primary font-semibold tracking-tighter text-balance ${className}`.trim()}
  >
    {title}
  </Text>
</div>
