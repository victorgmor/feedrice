---
import Logo from "@/components/assets/Logo.astro";
import StoreButton from "@/components/react/StoreButton";

const { links = [] } = Astro.props;
---

<div id="mobileMenu" class="fixed inset-0 z-40 hidden lg:hidden" aria-hidden="true">
  <div
    class="relative z-10 m-4 rounded-lg bg-secondary p-4 shadow-2xl outline-2 outline-primary/10"
  >
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-primary font-medium">
        <Logo />
      </a>
      <button
        class="text-primary text-sm duration-300 hover:text-primary/40"
        data-close-nav
      >
        Close
      </button>
    </div>
    <nav class="mt-12 flex flex-col gap-3">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-primary text-sm duration-300 hover:text-primary/40"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-12">
      <StoreButton client:load />
    </div>
  </div>
</div>
<script is:inline>
  const navToggle = document.getElementById("navToggle");
  const mobileMenu = document.getElementById("mobileMenu");
  const closeTargets = mobileMenu?.querySelectorAll("[data-close-nav]");
  const openNav = () => {
    mobileMenu.classList.remove("hidden");
    navToggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };
  const closeNav = () => {
    mobileMenu.classList.add("hidden");
    navToggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };
  navToggle?.addEventListener("click", () => {
    const isOpen = navToggle.getAttribute("aria-expanded") === "true";
    if (isOpen) closeNav();
    else openNav();
  });
  closeTargets?.forEach((btn) => {
    btn.addEventListener("click", closeNav);
  });
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024) closeNav();
  });
</script>
