---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { FOOTER_NODES } from "@/lib/menu";

const links = FOOTER_NODES.map((node) => ({
  name: node.title,
  url: `/${node.id}`,
}));
---

<footer>
  <Wrapper variant="standard" class="py-12">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <Text tag="p" variant="textSM" class="text-primary/60">
        © <span id="year"></span> feed·rice
      </Text>
      <ul role="list" class="flex flex-wrap gap-4">
        {
          links.map((link) => (
            <li>
              <Text
                tag="a"
                variant="textSM"
                class="text-primary/60 transition duration-300 ease-in-out hover:text-primary"
                href={link.url}
              >
                {link.name}
              </Text>
            </li>
          ))
        }
      </ul>
    </div>
  </Wrapper>
</footer>
<script type="module">
  const year = document.getElementById("year");
  if (year) year.textContent = String(new Date().getFullYear());
</script>
