---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/content/PageHero.astro";
import Paras from "@/components/content/Paras.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Text from "@/components/fundations/elements/Text.astro";
import { getPage } from "@/lib/menu";

const page = getPage("how-it-works")!;
---

<BaseLayout title={`${page.title} · feed·rice`} description={page.description}>
  <section>
    <PageHero title={page.title} />
    <Wrapper variant="standard" class="pb-24">
      <Wrapper variant="narrow">
        <Paras text={page.description} class="text-base text-primary/60" />
        <div class="mt-12 divide-y divide-primary/10 border-y border-primary/10">
          {
            (page.sections ?? []).map((section) => (
              <article class="py-10">
                {section.heading && (
                  <Text
                    tag="h2"
                    variant="textBase"
                    class="font-medium text-primary"
                  >
                    {section.heading}
                  </Text>
                )}
                {section.body && (
                  <div class="mt-3 space-y-4">
                    <Paras text={section.body} />
                  </div>
                )}
                {section.items && (
                  <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-primary/60">
                    {section.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
                {section.href && (
                  <p class="mt-4">
                    <a
                      href={section.href}
                      target={section.href.startsWith("http") ? "_blank" : undefined}
                      rel={section.href.startsWith("http") ? "noreferrer" : undefined}
                      class="text-sm underline hover:text-primary"
                    >
                      {section.hrefLabel ?? section.href}
                    </a>
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </Wrapper>
    </Wrapper>
  </section>
</BaseLayout>
